# ============================================
# NUMDOX Environment Configuration Example
# ============================================

ENV=development
DEBUG=True
DATABASE_URL=sqlite:///./numdox.db

# External Carrier & Validation APIs
NUMVERIFY_API_KEY=your_numverify_api_key
ABSTRACT_API_KEY=your_abstract_api_key

# RapidAPI & Truecaller Multi-Pool Keys
RAPIDAPI_TRUECALLER_KEY=your_rapidapi_key
TRUECALLER_AUTH_TOKEN=your_truecaller_token

# Optional Threat Intel & OSINT APIs
OPENCAGE_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
HIBP_API_KEY=
GITHUB_TOKEN=
GEMINI_API_KEY=